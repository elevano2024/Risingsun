# Third-party WP plugins — install locally (Elementor, Yoast, AIO, etc.). Do not commit.
wordpress-elementor/wp-content/plugins/*
!wordpress-elementor/wp-content/plugins/.gitkeep

# Elementor runtime CSS (regenerated locally)
public/wp-content/uploads/elementor/

# WordPress intermediate image sizes (regenerated by Media Library / wp media)
public/wp-content/uploads/**/*-150x150.*
public/wp-content/uploads/**/*-300x*.*
public/wp-content/uploads/**/*-768x*.*
public/wp-content/uploads/**/*-1024x*.*
public/wp-content/uploads/**/*-1536x*.*
public/wp-content/uploads/**/*-2048x*.*
public/wp-content/uploads/**/*-scaled-*.*

# Keep brand static pack tracked (logo, fonts, icons used by the theme)
!public/wp-content/uploads/rsms-static/
!public/wp-content/uploads/rsms-static/**